{
    // exe_name: 输出可执行文件名（不含扩展名）
    // sources: 参与编译的源文件列表（相对项目根目录）
    // extra_libraries: 额外链接库（gdi32 = Windows GDI，SmoothFont 需要）
    "exe_name": "GraphicsEngine",
    "sources": [
        "src/main.cpp",
        "src/vulkan_app.cpp",
        "src/engine/vulkan_context.cpp",
        "src/engine/vulkan_util.cpp",
        "src/engine/logger.cpp",
        "src/engine/pipelines.cpp",
        "src/shapes/shape.cpp",
        "src/geometry3d/mesh3d.cpp",
        "src/text/bitmap_font.cpp",
        "src/text/font.cpp",
        "src/text/text_renderer.cpp",
        "src/ui/ui_widgets.cpp",
        "src/ui/ui_manager.cpp",
        "src/ui/ui_loader.cpp",
        "src/ui/ui_json.cpp",
        "src/ui/ui_builder.cpp",
        "src/render/texture.cpp",
        "src/render/framebuffer.cpp",
        "src/render/postfx.cpp",
        "src/render/skybox.cpp",
        "src/render/shadow.cpp",
        "src/render/instancing.cpp",
        "src/render/particles.cpp",
        "src/render/mesh_loader.cpp",
        "src/render/debug_render.cpp"
    ],
    "extra_libraries": ["gdi32"]
}
